# Nginx Hosts
ALLOWED_HOSTS=lachiegrant.xyz www.lachiegrant.xyz localhost 127.0.0.1

# URLs
# GitHub and GitLab buttons work the same way: <HOST>_ACCOUNT picks the username,
# <HOST>_URL sets a full address instead, and <HOST>_URL=none hides the button.
# Defaults: github.com/lachieggg and gitlab.com/lachie-gitlab.
#GITHUB_ACCOUNT=lachieggg
#GITLAB_ACCOUNT=lachieggg
DOMAIN_NAME=domain.localhost
USER_EMAIL=lachie@localhost

# Paths
RESUME_PATH=cv/cv.pdf

# Image Configuration
BLOG_IMG="rpi.png"
HOME_IMG="rpi.png"
BOOK_IMG="rpi.png"
PICTURES="rpi.png"

# Feature Flags
ENABLE_BLOG=enabled
ENABLE_BOOKMARKS=enabled

# Home page background animation (see src/vanta_themes.go for the full
# registry and how to add a new one). Swapping just needs this value
# changed + `docker compose restart app` - no rebuild.
# Options: cells | topology | trunk
VANTA_THEME=cells

# Footer "hosted from" line and logo:
#   vps (default) = "Hosted from my VPS" + Debian logo
#   homelab       = "Hosted from my homelab" + Raspberry Pi logo
#   none          = no line
HOSTED_FROM=

# Emoji used as the browser-tab icon (default 👾; it has no background, so it
# blends into any tab). "none" = use the plain /favicon.ico file instead.
FAVICON_EMOJI=
